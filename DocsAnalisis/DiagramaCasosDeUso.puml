@startuml DiagramaCasosDeUso
left to right direction
skinparam packageStyle rectangle

actor "Admin" as admin
actor "Planillero" as planillero
actor "Usuario Invitado" as invitado

rectangle "VoleyTrack" {
  
  ' ===== GESTIÓN DE USUARIOS =====
  package "Gestión de Usuarios" {
    usecase "Registrar Planillero" as UC01
    usecase "Iniciar Sesión" as UC02
    usecase "Cerrar Sesión" as UC03
    usecase "Cambiar contraseña" as UC04
  }
  
  ' ===== GESTIÓN DE JUGADORES =====
  package "Gestión de Jugadores" {
    usecase "Crear Jugador" as UC05
    usecase "Actualizar Jugador" as UC06
    usecase "Eliminar Jugador" as UC07
  }
  
  ' ===== GESTIÓN DE EQUIPOS =====
  package "Gestión de Equipos" {
    usecase "Crear Equipo" as UC08
    usecase "Actualizar Equipo" as UC09
    usecase "Eliminar Equipo" as UC10
    usecase "Asignar Jugador a equipo" as UC11
    usecase "Desasignar Jugador de equipo" as UC12
    usecase "Cambiar Jugador de equipo" as UC13
  }
  
  ' ===== GESTIÓN DE PARTIDOS =====
  package "Gestión de Partidos" {
    usecase "Crear partido" as UC14
    usecase "Modificar partido" as UC15
  }
  
  ' ===== OPERACIÓN DEL PARTIDO =====
  package "Operación del Partido" {
    usecase "Iniciar Partido" as UC16
    usecase "Crear Alineaciones" as UC17
    usecase "Modificar Alineaciones" as UC18
    usecase "Asignar saque inicial" as UC19
    usecase "Iniciar Set" as UC20
    usecase "Anotar Punto" as UC21
    usecase "Deshacer Punto" as UC22
    usecase "Realizar sustitución" as UC23
    usecase "Terminar Set" as UC24
    usecase "Terminar Partido" as UC25
  }
  
  ' ===== VISUALIZACIÓN EN VIVO =====
  package "Visualización en Vivo" {
    usecase "Visualizar partido en vivo" as UC26
    usecase "Visualizar estadísticas en vivo" as UC27
  }
}

' ===== RELACIONES ADMIN =====
admin --> UC01
admin --> UC02
admin --> UC03
admin --> UC04
admin --> UC05
admin --> UC06
admin --> UC07
admin --> UC08
admin --> UC09
admin --> UC10
admin --> UC11
admin --> UC12
admin --> UC13
admin --> UC14
admin --> UC15

' ===== RELACIONES PLANILLERO =====
planillero --> UC02
planillero --> UC03
planillero --> UC04
planillero --> UC16
planillero --> UC17
planillero --> UC18
planillero --> UC19
planillero --> UC20
planillero --> UC21
planillero --> UC22
planillero --> UC23
planillero --> UC24
planillero --> UC25

' ===== RELACIONES USUARIO INVITADO =====
invitado --> UC26
invitado --> UC27

' ===== RELACIONES ENTRE CASOS DE USO =====
UC16 ..> UC17 : <<include>>
UC17 ..> UC19 : <<include>>
UC20 ..> UC19 : <<include>>
UC21 ..> UC24 : <<extend>>
UC21 ..> UC25 : <<extend>>

@enduml
