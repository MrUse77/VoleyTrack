generator client {
  provider     = "prisma-client"
  moduleFormat = "cjs"
  output       = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["plantel", "iam", "encuentros", "proyecciones"]
}

enum UserRole {
  ADMIN
  PLANILLERO

  @@schema("iam")
}

enum MatchState {
  DRAFT
  SCHEDULED
  LIVE
  FINISHED
  SUSPENDED

  @@schema("encuentros")
}

enum EventType {
  MATCH_START
  MATCH_END
  SET_START
  SET_END
  POINT
  SUBSTITUTION
  TIMEOUT
  CARD

  @@schema("encuentros")
}

model Player {
  id                   String         @id @default(uuid()) @db.Uuid
  name                 String         @db.VarChar(30)
  lastname             String         @db.VarChar(30)
  height               Int
  teams                TeamPlayer[]
  substitutionsAsEnter Substitution[] @relation("SubstitutionPlayerEnters")
  substitutionsAsLeave Substitution[] @relation("SubstitutionPlayerLeaves")

  @@map("players")
  @@schema("plantel")
}

model Team {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique @db.VarChar(30)
  nameTrainer String?      @map("name_trainer") @db.VarChar(30)
  players     TeamPlayer[]
  matchesAsA  Match[]      @relation("MatchTeamA")
  matchesAsB  Match[]      @relation("MatchTeamB")

  @@map("teams")
  @@schema("plantel")
}

model TeamPlayer {
  teamId   String @map("team_id") @db.Uuid
  playerId String @map("player_id") @db.Uuid
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([teamId, playerId])
  @@map("team_players")
  @@schema("plantel")
}

model User {
  id       String   @id @default(uuid()) @db.Uuid
  email    String   @unique @db.VarChar(120)
  password String   @db.VarChar(255)
  name     String   @db.VarChar(60)
  role     UserRole

  @@map("users")
  @@schema("iam")
}

model Match {
  id         String          @id @default(uuid()) @db.Uuid
  fecha      DateTime?       @db.Date
  state      MatchState      @default(DRAFT)
  teamAId    String          @map("team_a_id") @db.Uuid
  teamBId    String          @map("team_b_id") @db.Uuid
  teamA      Team            @relation("MatchTeamA", fields: [teamAId], references: [id])
  teamB      Team            @relation("MatchTeamB", fields: [teamBId], references: [id])
  sets       Set[]
  outbox     Outbox[]
  scoreboard LiveScoreboard?
  timeline   LiveTimeline[]

  @@map("matches")
  @@schema("encuentros")
}

model Set {
  id      String  @id @default(uuid()) @db.Uuid
  matchId String  @map("match_id") @db.Uuid
  numSet  Int     @map("num_set")
  match   Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  events  Event[]

  @@unique([matchId, numSet])
  @@map("sets")
  @@schema("encuentros")
}

model Event {
  id                     String           @id @default(uuid()) @db.Uuid
  setId                  String           @map("set_id") @db.Uuid
  type                   EventType
  nPoint                 Int?             @map("n_point")
  createdAt              DateTime         @default(now()) @map("created_at")
  set                    Set              @relation(fields: [setId], references: [id], onDelete: Cascade)
  substitution           Substitution?    @relation("EventSubstitution")
  scoreboardsAsLastEvent LiveScoreboard[] @relation("LiveScoreboardLastEvent")
  timeline               LiveTimeline[]

  @@map("events")
  @@schema("encuentros")
}

model Substitution {
  id             String @id @default(uuid()) @db.Uuid
  eventId        String @unique @map("event_id") @db.Uuid
  playerEntersId String @map("player_enters_id") @db.Uuid
  playerLeavesId String @map("player_leaves_id") @db.Uuid
  event          Event  @relation("EventSubstitution", fields: [eventId], references: [id], onDelete: Cascade)
  playerEnters   Player @relation("SubstitutionPlayerEnters", fields: [playerEntersId], references: [id])
  playerLeaves   Player @relation("SubstitutionPlayerLeaves", fields: [playerLeavesId], references: [id])

  @@map("substitutions")
  @@schema("encuentros")
}

model Outbox {
  id          String   @id @default(uuid()) @db.Uuid
  aggregateId String   @map("aggregate_id") @db.Uuid
  type        String   @db.VarChar(50)
  payload     Json
  consumed    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  match       Match    @relation(fields: [aggregateId], references: [id], onDelete: Cascade)

  @@map("outbox")
  @@schema("encuentros")
}

model LiveScoreboard {
  matchId     String  @id @map("match_id") @db.Uuid
  teamAName   String? @map("team_a_name") @db.VarChar(60)
  teamBName   String? @map("team_b_name") @db.VarChar(60)
  pointsA     Int     @default(0) @map("points_a")
  pointsB     Int     @default(0) @map("points_b")
  currentSet  Int     @default(1) @map("current_set")
  lastEventId String? @map("last_event_id") @db.Uuid
  match       Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  lastEvent   Event?  @relation("LiveScoreboardLastEvent", fields: [lastEventId], references: [id], onDelete: SetNull)

  @@map("live_scoreboards")
  @@schema("proyecciones")
}

model LiveTimeline {
  eventId       String   @id @map("event_id") @db.Uuid
  matchId       String   @map("match_id") @db.Uuid
  description   String?  @db.Text
  scoreSnapshot Json?    @map("score_snapshot")
  timestamp     DateTime @default(now())
  type          String   @db.VarChar(50)
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("live_timeline")
  @@schema("proyecciones")
}
